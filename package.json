{
  "name": "certwatch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "start": "npm --workspace apps/api run start",
    "test": "vitest run",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
